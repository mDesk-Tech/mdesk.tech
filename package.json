{
  "name": "mdesk.tech",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "pnpm check-types && pnpm run eslint && pnpm run prettier && pnpm run stylelint",
    "eslint": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{css,scss,sass,less,styl}\" --fix",
    "prettier": "prettier --write .",
    "check-types": "concurrently -n transpile,types -c cyan,magenta \"pnpm run check-types:transpile\" \"tsgo -p tsconfig.json\" && rm -rf .swc",
    "check-types:transpile": "swc app components hooks lib --out-dir .swc --ignore '**/*.d.ts' --ignore 'node_modules' --ignore '.next'",
    "prepare": "pnpm dlx husky",
    "check-deps": "pnpm dlx knip --fix"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@takumi-rs/image-response": "^0.73.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.1.1",
    "motion": "^12.38.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.21",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260329.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-next": "^16.2.1",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "postcss-load-config": "^6.0.1",
    "prettier": "3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "**/*.{js,ts,tsx,json,mjs,yaml,yml,css,md}": "prettier -w",
    "**/*.{css,scss,sass,less,styl}": "stylelint --fix"
  },
  "packageManager": "pnpm@10.33.0"
}
