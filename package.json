{
  "name": "mdesk.tech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "pnpm check-types && pnpm run eslint && pnpm run prettier && pnpm run stylelint",
    "eslint": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{css,scss,sass,less,styl}\" --fix",
    "prettier": "prettier --write .",
    "check-types": "concurrently -n transpile,types -c cyan,magenta \"pnpm run check-types:transpile\" \"tsgo -p tsconfig.json\" && rm -rf .swc",
    "check-types:transpile": "swc app components hooks lib --out-dir .swc --ignore '**/*.d.ts' --ignore 'node_modules' --ignore '.next'",
    "prepare": "pnpm dlx husky",
    "check-deps": "pnpm dlx knip --fix"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.1",
    "@react-three/fiber": "^9.5.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "dotted-map": "^2.2.3",
    "lucide-react": "^0.562.0",
    "mongodb": "^7.0.0",
    "motion": "^12.23.26",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@typescript/native-preview": "7.0.0-dev.20260104.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "prettier": "3.7.4",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "**/*.{js,ts,tsx,json,mjs,yaml,yml,css,md}": "prettier -w",
    "**/*.{css,scss,sass,less,styl}": "stylelint --fix"
  },
  "packageManager": "pnpm@10.27.0"
}
